<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页：全屏视频 + 按需唤出的自绘信息层（不显示播放进度条——直播流时长可能是 inf） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <SurfaceView
        android:id="@+id/playerSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 频道信息（3 秒后淡出，按任意键复现） -->
    <LinearLayout
        android:id="@+id/channelInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="28dp"
        android:background="@color/banner_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/infoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 起播状态（不允许静默黑屏：无画面时必须有可见状态） -->
    <TextView
        android:id="@+id/loadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/banner_bg"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        android:text="起播中…"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <!-- INFO 详细信息浮层（F16，按 INFO 键循环显示/隐藏） -->
    <LinearLayout
        android:id="@+id/infoOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/banner_bg"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="16dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlayLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/overlayLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- 数字换台回显（播放页） -->
    <TextView
        android:id="@+id/playerDigitDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:background="@color/banner_bg"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- APTV 风格的频道搜索与选择面板 -->
    <FrameLayout
        android:id="@+id/channelSearchPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:padding="48dp">

        <include
            android:id="@+id/panelChannelSearch"
            layout="@layout/panel_channel_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
